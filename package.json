{
  "name": "agent2lark-cursor",
  "version": "0.1.0",
  "description": "Cursor hooks adapter that bridges Cursor IDE Agent Chats with Feishu/Lark threads, plus self-contained remote tool approval.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "bin": {
    "agent2lark-cursor": "./bin/agent2lark-cursor.js",
    "agent2lark-cursor-bridge": "./bin/agent2lark-cursor-bridge.js",
    "agent2lark-cursor-hook": "./bin/agent2lark-cursor-hook.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "doctor": "node ./bin/agent2lark-cursor.js doctor",
    "bridge": "node ./bin/agent2lark-cursor.js bridge",
    "bridge:lark": "node ./bin/agent2lark-cursor.js bridge --lark-cli",
    "install-hooks": "node ./bin/agent2lark-cursor.js install",
    "install-relay-hooks": "node ./bin/agent2lark-cursor.js install --relay",
    "lark-listen": "node ./bin/agent2lark-cursor.js lark-listen",
    "lark-listen:debug": "node ./bin/agent2lark-cursor.js lark-listen --echo-message-id",
    "start-relay": "node ./bin/agent2lark-cursor.js start",
    "status-relay": "node ./bin/agent2lark-cursor.js status-relay",
    "stop-relay": "node ./bin/agent2lark-cursor.js stop-relay",
    "restart-relay": "node ./bin/agent2lark-cursor.js restart-relay",
    "uninstall-hooks": "node ./bin/agent2lark-cursor.js uninstall",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "keywords": [
    "cursor",
    "cursor-ide",
    "cursor-hooks",
    "lark",
    "feishu",
    "chatops",
    "agent",
    "agent2lark"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sherlockfeng/lark2cursor.git"
  },
  "homepage": "https://github.com/sherlockfeng/lark2cursor#readme",
  "bugs": {
    "url": "https://github.com/sherlockfeng/lark2cursor/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@larksuite/cli": "^1.0.23"
  }
}
